<%@ page contentType="text/html;charset=UTF-8" language="java" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html>
<html lang="fr"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mes missions</title>
<link rel="stylesheet" href="${ctx}/assets/css/fonts.css"><link rel="stylesheet" href="${ctx}/assets/css/employe.css?v=20261106-missions">
</head><body><div class="employe-page">
<aside class="employe-sidebar"><div class="employe-brand"><span>RH</span><div><strong>Besoins en personnel</strong><small>Espace employé</small></div></div><div class="employe-profile"><div class="employe-avatar"><c:out value="${employe.personne.prenom.substring(0,1)}"/></div><div><strong><c:out value="${employe.personne.nomComplet}"/></strong><small><c:out value="${employe.matricule}"/></small></div></div><nav><a href="${ctx}/employe/jours">Mes jours de travail</a><a class="active" href="${ctx}/employe/missions">Mes missions</a><a href="${ctx}/employe/profil">Mon profil</a></nav><a class="employe-logout" href="${ctx}/logout">Se déconnecter</a></aside>
<main class="employe-main"><header class="employe-header"><div><span class="employe-eyebrow">MON ESPACE</span><h1>Mes missions</h1><p>Retrouvez les missions auxquelles vous participez et votre rôle dans chacune.</p></div></header>
<c:if test="${not empty message}"><div class="employe-alert success"><c:out value="${message}"/></div></c:if><c:if test="${not empty error}"><div class="employe-alert error"><c:out value="${error}"/></div></c:if><section class="employe-card"><div class="employe-card-heading"><div><span>01</span><div><h2>Missions qui me sont affectées</h2><p><c:out value="${participations.size()}"/> participation(s)</p></div></div></div><div class="employe-mission-grid"><c:choose><c:when test="${empty participations}"><div class="employe-empty"><strong>Aucune mission affectée</strong><p>Les missions qui vous seront attribuées apparaîtront ici.</p></div></c:when><c:otherwise><c:forEach var="participation" items="${participations}"><article class="employe-mission-card"><div class="employe-mission-top"><div><span class="employe-label">MISSION</span><h3><c:out value="${participation.mission.titre}"/></h3></div><span class="mission-status-small mission-status-small-${participation.statut}"><c:out value="${participation.statut}"/></span></div><p class="employe-mission-description"><c:out value="${empty participation.mission.description ? 'Aucune description disponible.' : participation.mission.description}"/></p><dl><div><dt>Mon rôle</dt><dd><c:out value="${participation.roleMission}"/></dd></div><div><dt>Période</dt><dd><c:out value="${participation.mission.dateDebut}"/> <c:if test="${not empty participation.mission.dateFinPrevue}">→ <c:out value="${participation.mission.dateFinPrevue}"/></c:if></dd></div><div><dt>Priorité</dt><dd><c:out value="${participation.mission.priorite}"/></dd></div><div><dt>Responsable</dt><dd><c:out value="${participation.mission.responsable.nomComplet}"/></dd></div><div><dt>Temps consacré</dt><dd class="employe-mission-time"><c:out value="${dureesMission[participation.id]}"/></dd></div></dl><c:choose><c:when test="${participation.statut == 'TERMINEE'}"><div class="employe-mission-finished">Affectation terminée<c:if test="${not empty participation.dateFinReelle}"> le <c:out value="${participation.dateFinReelle}"/></c:if></div></c:when><c:when test="${participation.statut == 'ANNULEE'}"><div class="employe-mission-finished">Affectation annulée</div></c:when><c:when test="${minutesMission[participation.id] > 0}"><form class="employe-mission-finish-form" action="${ctx}/employe/missions/${participation.id}/terminer" method="post"><button type="submit">Terminer l'affectation</button></form></c:when><c:otherwise><div class="employe-mission-pending">Enregistrez du temps sur cette mission pour pouvoir la terminer.</div></c:otherwise></c:choose></article></c:forEach></c:otherwise></c:choose></div></section></main></div></body></html>
