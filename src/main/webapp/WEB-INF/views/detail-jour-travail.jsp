<%@ page contentType="text/html;charset=UTF-8" language="java" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Détail de journée</title><c:choose><c:when test="${espace == 'employe'}"><link rel="stylesheet" href="${ctx}/assets/css/fonts.css"><link rel="stylesheet" href="${ctx}/assets/css/employe.css?v=20261106-details"></c:when><c:otherwise><link rel="stylesheet" href="${ctx}/assets/css/fonts.css"><link rel="stylesheet" href="${ctx}/assets/css/base.css"><link rel="stylesheet" href="${ctx}/assets/css/besoins.css"><link rel="stylesheet" href="${ctx}/assets/css/composants.css"><link rel="stylesheet" href="${ctx}/assets/css/rh.css?v=20261106-details"></c:otherwise></c:choose></head>
<body><c:choose><c:when test="${espace == 'employe'}"><div class="employe-page"><aside class="employe-sidebar"><div class="employe-brand"><span>RH</span><div><strong>Besoins en personnel</strong><small>Espace employé</small></div></div><div class="employe-profile"><div class="employe-avatar"><c:out value="${jour.employe.personne.prenom.substring(0,1)}"/></div><div><strong><c:out value="${jour.employe.personne.nomComplet}"/></strong><small><c:out value="${jour.employe.matricule}"/></small></div></div><nav><a href="${ctx}/employe/jours">Mes jours de travail</a><a href="${ctx}/employe/missions">Mes missions</a><a href="${ctx}/employe/conges">Mes congés</a><a href="${ctx}/employe/profil">Mon profil</a></nav><a class="employe-logout" href="${ctx}/logout">Se déconnecter</a></aside><main class="employe-main detail-jour-page"><div class="detail-back"><a href="${ctx}/employe/jours">← Retour à mes jours</a></div><header class="employe-header"><div><span class="employe-eyebrow">JOURNÉE DE TRAVAIL</span><h1><c:out value="${jour.dateTravail}"/></h1><p>Décrivez les activités réalisées pendant vos heures de présence.</p></div></header>
</c:when><c:otherwise><div class="c-espace"><jsp:include page="/WEB-INF/views/fragments/espace-sidebar.jsp"><jsp:param name="role" value="rh"/><jsp:param name="active" value="jours"/></jsp:include><div class="contenu"><main class="page-espace c-page-liste c-annuaire-rh c-planning-page"><div class="dossier-retour"><a href="${ctx}/rh/planning/jours">← Retour aux jours de travail</a></div><header class="entete"><div><p class="surtitre">Vérification RH</p><h1>Détail de la journée</h1><p><c:out value="${jour.employe.personne.nomComplet}"/> · <c:out value="${jour.dateTravail}"/></p></div></header>
</c:otherwise></c:choose>
<c:if test="${not empty message}"><div class="${espace == 'employe' ? 'employe-alert success' : 'dossier-alert dossier-alert-ok'}"><c:out value="${message}"/></div></c:if><c:if test="${not empty error}"><div class="${espace == 'employe' ? 'employe-alert error' : 'dossier-alert dossier-alert-error'}"><c:out value="${error}"/></div></c:if>
<section class="${espace == 'employe' ? 'employe-card detail-jour-card' : 'carte c-table dossier-card detail-jour-card'}"><div class="${espace == 'employe' ? 'employe-card-heading' : 'dossier-card-heading'}"><div><span>01</span><div><h2>Résumé de la journée</h2><p>Présence réelle et temps calculé.</p></div></div></div><div class="detail-summary"><div><span>Horaire prévu</span><strong><c:out value="${jour.heureDebutPrevue}"/>–<c:out value="${jour.heureFinPrevue}"/></strong></div><div><span>Présence réelle</span><strong><c:out value="${jour.heureEntreeReelle}"/>–<c:out value="${jour.heureSortieReelle}"/></strong></div><div><span>Temps travaillé</span><strong><c:out value="${empty jour.minutesTravaillees ? '-' : jour.minutesTravaillees}"/> min</strong></div><div><span>Statut</span><strong><c:out value="${jour.statut}"/></strong></div></div></section>
<c:if test="${espace == 'employe'}"><section class="employe-card detail-jour-card detail-add-card"><div class="employe-card-heading"><div><span>02</span><div><h2>Ajouter une période</h2><p>Chaque période doit rester dans vos heures réelles et ne pas chevaucher une autre période.</p></div></div></div><form class="detail-form" action="${ctx}/planning/jours/${jour.id}/details" method="post"><label>Type<select name="type" class="champ" required><c:forEach var="type" items="${types}"><option value="${type}"><c:out value="${type}"/></option></c:forEach></select></label><label>Mission<select name="participationId" class="champ"><option value="">Aucune mission</option><c:forEach var="participation" items="${participations}"><option value="${participation.id}"><c:out value="${participation.mission.titre}"/> · <c:out value="${participation.roleMission}"/></option></c:forEach></select></label><label>Début<input class="champ" type="time" name="heureDebut" required></label><label>Fin<input class="champ" type="time" name="heureFin" required></label><label class="detail-description">Description<input class="champ" type="text" name="description" placeholder="Ex. développement de l'écran planning"></label><div class="detail-submit"><button class="bouton-principal" type="submit">Ajouter le détail</button></div></form></section></c:if>
<section class="${espace == 'employe' ? 'employe-card detail-jour-card' : 'carte c-table dossier-card detail-jour-card'}"><div class="${espace == 'employe' ? 'employe-card-heading' : 'dossier-card-heading'}"><div><span>03</span><div><h2>Chronologie de la journée</h2><p><c:out value="${details.size()}"/> période(s) enregistrée(s).</p></div></div></div><div class="${espace == 'employe' ? 'employe-table-wrap' : 'defilement'}"><table class="detail-table"><thead><tr><th>Horaire</th><th>Type</th><th>Mission</th><th>Durée</th><th>Description</th><th>Statut</th><c:if test="${espace == 'rh'}"><th>Action</th></c:if></tr></thead><tbody><c:choose><c:when test="${empty details}"><tr><td colspan="7" class="empty">Aucun détail n'est encore enregistré.</td></tr></c:when><c:otherwise><c:forEach var="detail" items="${details}"><tr><td><strong><c:out value="${detail.heureDebut}"/>–<c:out value="${detail.heureFin}"/></strong></td><td><c:out value="${detail.typeDetail}"/></td><td><c:out value="${empty detail.participationMission ? '-' : detail.participationMission.mission.titre}"/></td><td><c:out value="${detail.nombreMinutes}"/> min</td><td><c:out value="${empty detail.description ? '-' : detail.description}"/></td><td><span class="status status-${detail.statut}"><c:out value="${detail.statut}"/></span></td><c:if test="${espace == 'rh'}"><td><c:if test="${detail.statut == 'A_VERIFIER'}"><form class="detail-status-form" action="${ctx}/planning/jours/rh/details/${detail.id}/statut" method="post"><button name="statut" value="VALIDE" type="submit">Valider</button><button class="refuse" name="statut" value="REFUSE" type="submit">Refuser</button></form></c:if></td></c:if></tr></c:forEach></c:otherwise></c:choose></tbody></table></div></section>
<c:choose><c:when test="${espace == 'employe'}"></main></div></c:when><c:otherwise></main></div></div></c:otherwise></c:choose></body></html>
