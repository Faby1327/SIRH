<%@ page contentType="text/html;charset=UTF-8" language="java" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Demandes Direction</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/fonts.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/base.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/besoins.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/composants.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/directeur.css"></head><body>
<div class="c-espace"><jsp:include page="/WEB-INF/views/fragments/espace-sidebar.jsp"><jsp:param name="role" value="directeur"/><jsp:param name="active" value="accueil"/></jsp:include>
<div class="contenu"><main class="page-espace c-page-liste"><header class="entete"><div><p class="surtitre">Direction</p><h1>Suivi et approbation des demandes</h1></div></header><c:if test="${not empty message}"><div class="bandeau" role="status"><c:out value="${message}"/></div></c:if><c:if test="${not empty error}"><div class="bandeau bandeau-erreur" role="alert"><c:out value="${error}"/></div></c:if>
<div class="tuiles"><div class="c-tuile"><div class="tuile-label">En attente</div><div class="tuile-valeur">${aApprouver}</div></div><div class="c-tuile"><div class="tuile-label">Validé</div><div class="tuile-valeur">${approuvees}</div></div><div class="c-tuile"><div class="tuile-label">Refusé</div><div class="tuile-valeur">${refusees}</div></div></div>
<section class="carte c-table c-table-directeur" aria-labelledby="titre-demandes"><div class="entete"><h2 id="titre-demandes">Suivi des demandes de personnel</h2><p>${demandes.size()} demandes · validations et coûts estimés</p></div><div class="filtres"><div class="recherche"><input type="search" class="champ champ-recherche" aria-label="Rechercher" placeholder="Rechercher par n°, poste, service…" data-table-search></div><div class="filtre filtre-statut"><label for="dir-statut">Statut Direction</label><select id="dir-statut" class="champ" data-table-filter="statut"><option value="">Tous les statuts</option><option value="EN_ATTENTE">En attente</option><option value="VALIDEE">Validé</option><option value="REFUSEE">Refusé</option></select></div><div class="filtre filtre-service"><label for="dir-service">Service</label><select id="dir-service" class="champ" data-table-filter="service"><option value="">Tous les services</option><c:forEach var="d" items="${departements}"><option value="${d.nom}"><c:out value="${d.nom}"/></option></c:forEach></select></div></div>
<div class="defilement"><div class="tableau" role="table"><div class="ligne ligne-titres" role="row"><div class="titre">N°</div><div class="titre">Poste demandé</div><div class="titre">Service</div><div class="titre">Pers.</div><div class="titre">Coût estimé</div><div class="titre">Statut</div><div class="titre">Avancement</div><div class="titre">Mise à jour</div><div class="titre">Actions</div></div><div role="rowgroup"><c:forEach var="demande" items="${demandes}"><c:set var="statut" value="${demande.statutActuel.libelle}"/><c:set var="statutRole" value="${statutsRole[demande.idDemande]}"/><div class="ligne" role="row" data-table-row data-search="DP-${demande.idDemande} ${demande.poste.intitule} ${demande.departement.nom}" data-statut="${statutRole}" data-service="${demande.departement.nom}"><div class="cellule numero">DP-${demande.idDemande}</div><div class="cellule poste"><c:out value="${demande.poste.intitule}"/></div><div class="cellule"><c:out value="${demande.departement.nom}"/></div><div class="cellule">${demande.nombrePersonnes}</div><div class="cellule cout">${demande.budgetDemande} Ar</div><div class="cellule"><span class="puce ${statutRole == 'VALIDEE' ? 'puce-valide' : (statutRole == 'REFUSEE' ? 'puce-refuse' : 'puce-attente')}">${statutRole == 'EN_ATTENTE' ? 'En attente' : (statutRole == 'VALIDEE' ? 'Validé' : 'Refusé')}</span></div><div class="cellule"><div class="c-stepbar"><span class="libelle"><c:choose><c:when test="${statut == 'EN_ATTENTE_VALIDATION'}">En attente Directeur</c:when><c:when test="${statut == 'EN_VERIFICATION_FINANCIERE'}">En attente Finance</c:when><c:when test="${statut == 'VALIDEE'}">Approuvée</c:when><c:when test="${statut == 'REFUSEE'}">Refusée</c:when><c:otherwise>Soumise</c:otherwise></c:choose></span><div class="barre"><span class="segment ${statut == 'BROUILLON' ? 'a-faire' : 'faite'}"></span><span class="segment ${statut == 'SOUMISE' || statut == 'EN_VERIFICATION_FINANCIERE' ? 'en-cours' : (statut == 'BROUILLON' ? 'a-faire' : 'faite')}"></span><span class="segment ${statut == 'EN_ATTENTE_VALIDATION' ? 'en-cours' : (statut == 'VALIDEE' || statut == 'REFUSEE' ? 'faite' : 'a-faire')}"></span><span class="segment ${statut == 'EN_ATTENTE_VALIDATION' ? 'en-cours' : (statut == 'VALIDEE' ? 'approuvee' : (statut == 'REFUSEE' ? 'refusee' : 'a-faire'))}"></span></div></div></div><div class="cellule date">${demande.dateDemandeFormatee}</div><div class="cellule"><a href="${pageContext.request.contextPath}/directeur/detail/${demande.idDemande}" class="bouton">Voir</a></div></div></c:forEach><c:if test="${empty demandes}"><div class="ligne"><div class="cellule" style="grid-column:1/-1">Aucune demande à afficher.</div></div></c:if></div></div></div><p class="legende">Le statut indique votre décision à la Direction. L’avancement à côté montre l’état global du circuit.</p></section></main></div></div><script src="${pageContext.request.contextPath}/assets/js/table-filtres.js"></script>
</body></html>
