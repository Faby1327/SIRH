<%@ page contentType="text/html;charset=UTF-8" language="java" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Détail Direction</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/fonts.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/base.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/besoins.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/composants.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/decision.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/directeur.css"></head><body>
<div class="c-espace"><jsp:include page="/WEB-INF/views/fragments/espace-sidebar.jsp"><jsp:param name="role" value="directeur"/><jsp:param name="active" value="accueil"/></jsp:include>
<div class="contenu"><main class="page-espace c-detail c-detail-directeur"><header class="entete"><a href="${pageContext.request.contextPath}/directeur/accueil" class="retour">← Retour aux demandes</a><div><p class="surtitre">Direction</p><h1>Détail de la demande</h1></div></header><section class="carte" aria-labelledby="titre-detail"><div class="titre-ligne"><div><div class="reference">DP-${demande.idDemande} · demandée par <c:out value="${demande.manager.nom}"/></div><h2 id="titre-detail"><c:out value="${demande.poste.intitule}"/></h2></div><span class="puce ${demande.statutActuel.libelle == 'VALIDEE' ? 'puce-valide' : (demande.statutActuel.libelle == 'REFUSEE' ? 'puce-refuse' : 'puce-attente')}"><c:out value="${demande.statutActuel.libelleAffiche}"/></span></div>
<jsp:include page="/WEB-INF/views/fragments/avancement-demande.jsp"/>
<div class="bloc"><h3>Informations de la demande</h3><dl class="infos"><div class="info"><dt>Type de besoin</dt><dd><c:out value="${demande.typeRecrutementAffiche}"/></dd></div><div class="info"><dt>Poste demandé</dt><dd><c:out value="${demande.poste.intitule}"/></dd></div><div class="info"><dt>Nombre de personnes</dt><dd>${demande.nombrePersonnes}</dd></div><div class="info"><dt>Service concerné</dt><dd><c:out value="${demande.departement.nom}"/></dd></div><div class="info"><dt>Budget estimé par effectif</dt><dd>${demande.budgetDemande} Ar</dd></div><div class="info"><dt>Coût total estimé</dt><dd>${demande.budgetTotalEstime} Ar</dd></div><div class="info"><dt>Demandée par</dt><dd><c:out value="${demande.manager.nom}"/></dd></div><div class="info"><dt>Soumise le</dt><dd>${demande.dateDemandeFormatee}</dd></div><div class="info info-large"><dt>Motif du besoin</dt><dd class="texte"><c:out value="${demande.motif}"/></dd></div></dl></div>
<div class="bloc"><h3>Suivi des validations</h3><ol class="suivi"><li class="validation"><div class="validation-nom">Manager</div><div class="validation-corps"><p>Demande soumise le ${demande.dateDemandeFormatee} par <c:out value="${demande.manager.nom}"/>.</p></div><span class="puce puce-valide">Soumise</span></li><c:forEach var="h" items="${historique}"><li class="validation"><div class="validation-nom"><c:out value="${h.typeValidation}"/></div><div class="validation-corps"><p>${h.dateChangement} · <c:out value="${h.utilisateur.nom}"/> · <c:out value="${h.statut.libelleAffiche}"/></p><c:if test="${not empty h.remarque}"><p><c:out value="${h.remarque}"/></p></c:if></div><span class="puce puce-valide">Traitée</span></li></c:forEach><c:if test="${demande.statutActuel.libelle == 'EN_ATTENTE_VALIDATION'}"><li class="validation"><div class="validation-nom">Direction</div><div class="validation-corps"><p>En attente de votre décision.</p></div><span class="puce puce-attente">En attente</span></li></c:if></ol></div>
<div class="bloc"><h3>Vérification budgétaire</h3><div class="cartes-budget"><div class="carte-budget"><div class="carte-budget-label">Budget minimal autorisé pour le poste</div><div class="carte-budget-valeur">${budgetMin} Ar</div></div><div class="carte-budget"><div class="carte-budget-label">Budget unitaire estimé</div><div class="carte-budget-valeur">${demande.budgetDemande} Ar</div></div><div class="carte-budget ${budgetCompatible ? 'carte-budget-ok' : ''}"><div class="carte-budget-label">Budget maximal autorisé</div><div class="carte-budget-valeur">${budgetMax} Ar</div></div></div><p class="note-budget"><c:choose><c:when test="${budgetCompatible}">La demande respecte les contrôles budgétaires (fourchette poste et budget entreprise).</c:when><c:otherwise>La demande ne respecte pas au moins un contrôle budgétaire.</c:otherwise></c:choose></p></div>
<c:if test="${demande.statutActuel.libelle == 'EN_ATTENTE_VALIDATION'}"><div class="bloc"><h3>Décision de la Direction</h3><div class="actions"><span class="note">L’approbation termine le circuit de validation.</span><div class="boutons"><button type="button" class="refuser" data-open-refus="#refus-directeur">Refuser la demande</button><form action="${pageContext.request.contextPath}/directeur/approuver/${demande.idDemande}" method="post"><button class="approuver" type="submit">Approuver la demande →</button></form></div></div><form id="refus-directeur" class="refus" data-refus-form hidden action="${pageContext.request.contextPath}/directeur/refuser/${demande.idDemande}" method="post"><label for="remarque" class="refus-label">Motif du refus (obligatoire)</label><p class="refus-aide">Expliquez la décision de refus. Le commentaire sera transmis au Manager.</p><textarea id="remarque" name="remarque" rows="4" class="refus-champ" required></textarea><div class="refus-boutons"><button type="button" class="annuler" data-close-refus>Annuler</button><button type="submit" class="confirmer">Confirmer le refus</button></div></form></div></c:if>
</section></main></div></div><script src="${pageContext.request.contextPath}/assets/js/refus-form.js"></script>
</body></html>
