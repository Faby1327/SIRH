<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html>
<html lang="fr"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mes jours de travail</title>
<link rel="stylesheet" href="${ctx}/assets/css/fonts.css"><link rel="stylesheet" href="${ctx}/assets/css/employe.css?v=20261106">
</head><body><div class="employe-page">
<aside class="employe-sidebar"><div class="employe-brand"><span>RH</span><div><strong>Besoins en personnel</strong><small>Espace employé</small></div></div><div class="employe-profile"><div class="employe-avatar"><c:out value="${employe.personne.prenom.substring(0,1)}"/></div><div><strong><c:out value="${employe.personne.nomComplet}"/></strong><small><c:out value="${employe.matricule}"/></small></div></div><nav><a class="active" href="${ctx}/employe/jours">Mes jours de travail</a><a href="${ctx}/employe/missions">Mes missions</a></nav><a class="employe-logout" href="${ctx}/logout">Se déconnecter</a></aside>
<main class="employe-main"><header class="employe-header"><div><span class="employe-eyebrow">MON ESPACE</span><h1>Mes jours de travail</h1><p>Consultez votre planning et renseignez vos heures réelles.</p></div><div class="employe-month"><a href="${ctx}/employe/jours?mois=${periodePrecedente}">‹</a><strong><c:out value="${periodeLibelle}"/></strong><a href="${ctx}/employe/jours?mois=${periodeSuivante}">›</a></div></header>
<c:if test="${not empty message}"><div class="employe-alert success"><c:out value="${message}"/></div></c:if><c:if test="${not empty error}"><div class="employe-alert error"><c:out value="${error}"/></div></c:if>
<section class="employe-card"><div class="employe-card-heading"><div><span>01</span><div><h2>Mon planning du mois</h2><p><c:out value="${jours.size()}"/> journée(s) planifiée(s)</p></div></div></div><div class="employe-table-wrap"><table><thead><tr><th>Date</th><th>Horaire prévu</th><th>Mes heures</th><th>Résultat</th><th>Statut</th><th>Action</th></tr></thead><tbody>
<c:choose><c:when test="${empty jours}"><tr><td colspan="6" class="empty">Aucune journée planifiée pour cette période.</td></tr></c:when><c:otherwise><c:forEach var="jour" items="${jours}"><tr><td><strong><c:out value="${jour.dateTravail}"/></strong></td><td><c:out value="${jour.heureDebutPrevue}"/>–<c:out value="${jour.heureFinPrevue}"/><small>Pause : <c:out value="${jour.pausePrevueMinutes}"/> min</small></td><td><c:choose><c:when test="${not empty jour.heureEntreeReelle}"><c:out value="${jour.heureEntreeReelle}"/>–<c:out value="${jour.heureSortieReelle}"/></c:when><c:otherwise><span class="muted">Non renseigné</span></c:otherwise></c:choose></td><td><c:choose><c:when test="${not empty jour.minutesTravaillees}"><c:out value="${jour.minutesTravaillees}"/> min</c:when><c:otherwise>—</c:otherwise></c:choose></td><td><span class="status status-${jour.statut}"><c:out value="${jour.statut}"/></span></td><td><button class="action-button" type="button" data-target="edit-${jour.id}">Renseigner</button></td></tr><tr id="edit-${jour.id}" class="edit-row"><td colspan="6"><form action="${ctx}/employe/jours/${jour.id}/heures" method="post"><strong>Heures du <c:out value="${jour.dateTravail}"/></strong><label>Entrée <input type="time" name="entree" value="${jour.heureEntreeReelle}" required></label><label>Sortie <input type="time" name="sortie" value="${jour.heureSortieReelle}" required></label><input type="hidden" name="mois" value="${periode}"><button type="submit">Enregistrer</button></form></td></tr></c:forEach></c:otherwise></c:choose>
</tbody></table></div></section></main></div><script>document.querySelectorAll('.action-button').forEach((b)=>b.addEventListener('click',()=>document.getElementById(b.dataset.target).classList.toggle('visible')));</script></body></html>
