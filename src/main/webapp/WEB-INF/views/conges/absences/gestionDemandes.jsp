<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html>
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Gestion des congés et absences</title>
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/fonts.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/base.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/besoins.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/composants.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/bloc7.css?v=20261107-ui3"></head>
<body><div class="c-espace"><jsp:include page="/WEB-INF/views/fragments/espace-sidebar.jsp"><jsp:param name="role" value="${role == 'MANAGER' ? 'manager' : 'rh'}"/><jsp:param name="active" value="conges"/></jsp:include><div class="contenu"><main class="page-espace c-absences">
<header class="entete"><div><p class="surtitre">Espace de travail</p><h1>Gestion des congés et absences</h1></div></header>
<c:if test="${not empty message}"><p class="bandeau"><c:out value="${message}"/></p></c:if><c:if test="${not empty error}"><p class="bandeau bandeau-erreur"><c:out value="${error}"/></p></c:if>
<section class="carte"><input class="tab-radio" type="radio" name="onglet" id="tab-conge" checked><label for="tab-conge">Congés</label><input class="tab-radio" type="radio" name="onglet" id="tab-absence"><label for="tab-absence">Absences</label>
<div class="panneau contenu-conge"><h2>Demandes de congé</h2><div class="defilement"><table><thead><tr><th>Employé</th><th>Période</th><th>Jours</th><th>Statut</th><th>Détail et décision</th></tr></thead><tbody>
<c:forEach var="d" items="${demandesConge}"><tr><td><c:out value="${d.employe.personne.nomComplet}"/></td><td>${d.dateDebut} – ${d.dateFin}</td><td>${d.jours}</td><td><c:out value="${d.statut}"/></td><td class="actions"><a href="${pageContext.request.contextPath}/detailsDemande?type=conge&id=${d.id}">Détails</a>

</td></tr></c:forEach><c:if test="${empty demandesConge}"><tr><td colspan="5" class="vide">Aucune demande.</td></tr></c:if></tbody></table></div></div>
<div class="panneau contenu-absence"><c:if test="${role == 'MANAGER'}"><h2>Déclarer une absence pour un employé</h2><form class="formulaire-demande" action="${pageContext.request.contextPath}/gestion-demandes/absence" method="post" enctype="multipart/form-data"><label class="large">Employé<select name="employeId" required><option value="">Choisir un employé</option><c:forEach var="e" items="${employes}"><option value="${e.id}"><c:out value="${e.personne.nomComplet}"/> — <c:out value="${contratsActifs[e.id].poste.intitule}" default="Poste non défini"/></option></c:forEach></select></label><label>Du<input type="date" name="dateDebut" min="${today}" required></label><label>Au<input type="date" name="dateFin" min="${today}" required></label><label>Motif<input name="motif" required></label><label>Justificatif<input type="file" name="justificatif" accept="application/pdf,image/png,image/jpeg"></label><button class="bouton-principal">Enregistrer et transmettre à RH</button></form></c:if>
<h2>Absences du périmètre</h2><div class="defilement"><table><thead><tr><th>Employé</th><th>Période</th><th>Jours calendaires</th><th>Statut</th><c:choose><c:when test="${role == 'RH'}"><th>Département</th><th>Poste</th></c:when><c:otherwise><th>Poste</th></c:otherwise></c:choose><th>Justificatif</th><th>Action</th></tr></thead><tbody><c:forEach var="d" items="${demandesAbsence}"><tr><td><c:out value="${d.employe.personne.nomComplet}"/></td><td>${d.dateDebut} – ${d.dateFin}</td><td>${d.jours}</td><td><c:out value="${d.statut}"/></td><c:choose><c:when test="${role == 'RH'}"><td><c:out value="${contratsActifs[d.employe.id].poste.departement.nom}" default="—"/></td><td><c:out value="${contratsActifs[d.employe.id].poste.intitule}" default="—"/></td></c:when><c:otherwise><td><c:out value="${contratsActifs[d.employe.id].poste.intitule}" default="—"/></td></c:otherwise></c:choose><td><c:if test="${not empty d.justificatifUrl}"><a href="${pageContext.request.contextPath}${d.justificatifUrl}">Ouvrir</a></c:if></td><td class="actions"><a href="${pageContext.request.contextPath}/detailsDemande?type=absence&id=${d.id}">Détails</a></td></tr></c:forEach><c:if test="${empty demandesAbsence}"><tr><td colspan="${role == 'RH' ? 8 : 7}" class="vide">Aucune absence.</td></tr></c:if></tbody></table></div></div></section>
</main></div></div><script src="${pageContext.request.contextPath}/assets/js/validation-periode.js?v=20261107-ui3"></script></body></html>
