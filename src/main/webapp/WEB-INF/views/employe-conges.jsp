<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="ctx" value="${pageContext.request.contextPath}"/><!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Mes congés</title><link rel="stylesheet" href="${ctx}/assets/css/fonts.css"><link rel="stylesheet" href="${ctx}/assets/css/employe.css?v=20261112-conges-v4"></head><body><div class="employe-page"><aside class="employe-sidebar"><div class="employe-brand"><span>RH</span><div><strong>Besoins en personnel</strong><small>Espace employé</small></div></div><div class="employe-profile"><div class="employe-avatar"><c:out value="${employe.personne.prenom.substring(0,1)}"/></div><div><strong><c:out value="${employe.personne.nomComplet}"/></strong><small><c:out value="${employe.matricule}"/></small></div></div><nav><a href="${ctx}/employe/jours">Mes jours de travail</a><a href="${ctx}/employe/missions">Mes missions</a><a class="active" href="${ctx}/employe/conges">Mes congés</a><a href="${ctx}/employe/profil">Mon profil</a></nav><a class="employe-logout" href="${ctx}/logout">Se déconnecter</a></aside><main class="employe-main"><header class="employe-header"><div><span class="employe-eyebrow">MON ESPACE</span><h1>Mes congés</h1><p>Solde actuel : <c:out value="${soldeConge}"/> jour(s). Envoyez une demande aux ressources humaines.</p></div></header><c:if test="${not empty message}"><div class="employe-alert success"><c:out value="${message}"/></div></c:if><c:if test="${not empty error}"><div class="employe-alert error"><c:out value="${error}"/></div></c:if><c:if test="${not empty alerteSolde}"><div class="employe-alert error"><c:out value="${alerteSolde}"/></div></c:if><section class="employe-card conges-card"><div class="employe-card-heading"><div><span>01</span><div><h2>Demander un congé</h2><p>Votre demande devra être validée par les RH.</p></div></div></div><form class="detail-form conges-form" action="${ctx}/employe/conges" method="post"><label><span>Date de début</span><input class="champ" id="date-debut-conge" type="date" name="dateDebut" min="${aujourdHui}" required></label><label><span>Date de fin</span><input class="champ" id="date-fin-conge" type="date" name="dateFin" min="${aujourdHui}" required></label><label class="detail-description"><span>Motif <small>(facultatif)</small></span><textarea class="champ" name="motif" rows="3" placeholder="Indiquez le motif de votre demande"></textarea></label><div class="detail-submit"><button type="submit">Envoyer la demande</button></div></form></section><section class="employe-card conges-card"><div class="employe-card-heading"><div><span>02</span><div><h2>Mes demandes et absences</h2><p>Suivez leur statut de traitement.</p></div></div></div><div class="employe-table-wrap"><table><thead><tr><th>Période</th><th>Type</th><th>Jours demandés</th><th>Motif</th><th>Statut</th></tr></thead><tbody><c:choose><c:when test="${empty absences}"><tr><td colspan="5">Aucune demande.</td></tr></c:when><c:otherwise><c:forEach var="a" items="${absences}"><tr><td><c:out value="${a.dateDebut}"/> → <c:out value="${a.dateFin}"/></td><td><c:out value="${a.typeAbsence}"/><c:if test="${a.typeAbsence == 'CONGE'}"><small>Solde restant : <c:out value="${soldeConge}"/> jour(s)</small></c:if></td><td><c:out value="${joursDemandes[a.id]}"/> jour(s)</td><td><c:out value="${empty a.motif ? '—' : a.motif}"/></td><td><c:out value="${a.statut}"/></td></tr></c:forEach></c:otherwise></c:choose></tbody></table></div></section></main></div><script>(()=>{const d=document.getElementById("date-debut-conge"),f=document.getElementById("date-fin-conge");if(!d||!f)return;const maj=()=>{f.min=d.value||d.min;if(f.value&&d.value&&f.value<d.value)f.value=""};d.addEventListener("change",maj);maj()})();</script></body></html>
