<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Mon profil</title><link rel="stylesheet" href="${ctx}/assets/css/fonts.css"><link rel="stylesheet" href="${ctx}/assets/css/employe.css?v=20261109-profil"></head><body><div class="employe-page"><aside class="employe-sidebar"><div class="employe-brand"><span>RH</span><div><strong>Besoins en personnel</strong><small>Espace employé</small></div></div><div class="employe-profile"><div class="employe-avatar"><c:out value="${employe.personne.prenom.substring(0,1)}"/></div><div><strong><c:out value="${employe.personne.nomComplet}"/></strong><small><c:out value="${employe.matricule}"/></small></div></div><nav><a href="${ctx}/employe/jours">Mes jours de travail</a><a href="${ctx}/employe/missions">Mes missions</a><a class="active" href="${ctx}/employe/profil">Mon profil</a></nav><a class="employe-logout" href="${ctx}/logout">Se déconnecter</a></aside><main class="employe-main"><header class="employe-header"><div><span class="employe-eyebrow">MON ESPACE</span><h1>Mon profil</h1><p>Consultez les informations de votre dossier employé.</p></div><c:if test="${not empty employe.photo}"><img class="employe-profile-photo" src="${ctx}/employes/${employe.id}/photo" alt="Photo de profil"></c:if></header>
<section class="employe-card employe-profile-card"><div class="employe-card-heading"><div><span>01</span><div><h2>Informations personnelles</h2><p>Informations enregistrées par les ressources humaines.</p></div></div></div><div class="employe-profile-grid"><div><span>Nom complet</span><strong><c:out value="${employe.personne.nomComplet}"/></strong></div><div><span>Email</span><strong><c:out value="${employe.personne.email}"/></strong></div><div><span>Téléphone</span><strong><c:out value="${empty employe.personne.telephone ? '—' : employe.personne.telephone}"/></strong></div><div><span>Date de naissance</span><strong><c:out value="${empty employe.personne.dateNaissance ? '—' : employe.personne.dateNaissance}"/></strong></div><div><span>Adresse</span><strong><c:out value="${empty employe.adresse ? '—' : employe.adresse}"/></strong></div><div><span>Commune</span><strong><c:out value="${empty employe.commune ? '—' : employe.commune}"/></strong></div><div><span>Nationalité</span><strong><c:out value="${empty employe.nationalite ? '—' : employe.nationalite}"/></strong></div><div><span>Situation matrimoniale</span><strong><c:out value="${empty employe.situationMatrimoniale ? '—' : employe.situationMatrimoniale}"/></strong></div></div></section>
<section class="employe-card employe-profile-card"><div class="employe-card-heading"><div><span>02</span><div><h2>Situation professionnelle</h2><p>Informations liées à votre emploi.</p></div></div></div><div class="employe-profile-grid"><div><span>Matricule</span><strong><c:out value="${employe.matricule}"/></strong></div><div><span>Date d'embauche</span><strong><c:out value="${employe.dateEmbauche}"/></strong></div><div><span>Département</span><strong><c:out value="${empty employe.departement ? '—' : employe.departement.nom}"/></strong></div><div><span>Poste</span><strong><c:out value="${empty employe.poste ? '—' : employe.poste.intitule}"/></strong></div><div><span>Statut</span><strong><c:out value="${employe.statut}"/></strong></div><div><span>Salaire actuel</span><strong><c:choose><c:when test="${empty employe.salaireActuel}">—</c:when><c:otherwise><c:out value="${employe.salaireActuel}"/> Ar</c:otherwise></c:choose></strong></div></div></section>
<section class="employe-card employe-profile-card"><div class="employe-card-heading"><div><span>03</span><div><h2>Mes contrats</h2><p><c:out value="${contrats.size()}"/> contrat(s)</p></div></div></div><div class="employe-documents"><c:choose><c:when test="${empty contrats}"><p class="employe-muted">Aucun contrat enregistré.</p></c:when><c:otherwise><c:forEach var="contrat" items="${contrats}"><div class="employe-document-row"><div><strong><c:out value="${contrat.typeContrat}"/> · <c:out value="${contrat.poste.intitule}"/></strong><small>Du <c:out value="${contrat.dateDebut}"/> <c:if test="${not empty contrat.dateFin}">au <c:out value="${contrat.dateFin}"/></c:if> · <c:out value="${contrat.salaireMensuel}"/> <c:out value="${contrat.devise}"/></small></div><span class="status status-${contrat.statut}"><c:out value="${contrat.statut}"/></span></div></c:forEach></c:otherwise></c:choose></div></section>
<section class="employe-card employe-profile-card"><div class="employe-card-heading"><div><span>04</span><div><h2>Mes documents</h2><p><c:out value="${documents.size()}"/> document(s)</p></div></div></div><div class="employe-documents"><c:choose><c:when test="${empty documents}"><p class="employe-muted">Aucun document disponible.</p></c:when><c:otherwise><c:forEach var="document" items="${documents}"><div class="employe-document-row"><div><strong><c:out value="${document.typeDocument.libelle}"/></strong><small><c:out value="${document.nomFichier}"/></small></div><a class="action-button" href="${ctx}/employes/${employe.id}/documents/${document.id}">Télécharger</a></div></c:forEach></c:otherwise></c:choose></div></section></main></div></body></html>
