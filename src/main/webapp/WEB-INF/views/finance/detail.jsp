<%@ page contentType="text/html;charset=UTF-8" language="java" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Détail Finance</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/fonts.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/base.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/besoins.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/composants.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/decision.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/finance.css"></head>
<body><div class="c-espace"><jsp:include page="/WEB-INF/views/fragments/espace-sidebar.jsp"><jsp:param name="role" value="finance"/><jsp:param name="active" value="accueil"/></jsp:include>
<div class="contenu"><main class="page-espace c-detail c-detail-finance"><header class="entete"><a href="${pageContext.request.contextPath}/finance/accueil" class="retour">← Retour aux demandes</a><div><p class="surtitre">Service Finance</p><h1>Détail de la demande</h1></div></header><section class="carte" aria-labelledby="titre-detail"><div class="titre-ligne"><div><div class="reference">DP-${demande.idDemande} · demandée par <c:out value="${demande.manager.nom}"/></div><h2 id="titre-detail"><c:out value="${demande.poste.intitule}"/></h2></div><span class="puce puce-attente"><c:out value="${demande.statutActuel.libelleAffiche}"/></span></div>
<jsp:include page="/WEB-INF/views/fragments/avancement-demande.jsp"/>
<div class="bloc"><h3>Informations de la demande</h3><dl class="infos"><div class="info"><dt>Département concerné</dt><dd><c:out value="${demande.departement.nom}"/></dd></div><div class="info"><dt>Type de besoin</dt><dd><c:out value="${demande.typeRecrutementAffiche}"/></dd></div><div class="info"><dt>Poste demandé</dt><dd><c:out value="${demande.poste.intitule}"/></dd></div><div class="info"><dt>Nombre de personnes</dt><dd>${demande.nombrePersonnes}</dd></div><div class="info"><dt>Budget estimé par effectif</dt><dd class="sans-coupure">${demande.budgetDemande} Ar</dd></div><div class="info"><dt>Coût total estimé</dt><dd class="sans-coupure">${budgetTotalEstime} Ar</dd></div><div class="info"><dt>Demandée par</dt><dd><c:out value="${demande.manager.nom}"/></dd></div><div class="info"><dt>Date de la demande</dt><dd>${demande.dateDemandeFormatee}</dd></div><div class="info info-large"><dt>Motif du besoin</dt><dd class="texte"><c:out value="${demande.motif}"/></dd></div></dl></div>
<div class="bloc"><h3>Règles budgétaires</h3><div class="ligne-budget"><span class="libelle">Budget minimal (unitaire)</span><span class="valeur">${budgetMin} Ar</span></div><div class="ligne-budget"><span class="libelle">Budget maximal (unitaire)</span><span class="valeur">${budgetMax} Ar</span></div><div class="ligne-budget"><span class="libelle">Budget entreprise (${anneeBudget})</span><span class="valeur">${budgetEntrepriseDisponible} Ar</span></div><div class="ligne-budget total"><span>Coût total estimé (budget × effectif)</span><span class="valeur">${budgetTotalEstime} Ar</span></div></div>
<div class="bloc"><h3>Vérification de compatibilité</h3><div class="verdict ${budgetCompatible ? 'verdict-ok' : 'verdict-ko'}" role="status"><div class="verdict-texte"><span class="icone">${budgetCompatible ? '✓' : '!'}</span><div><div class="verdict-titre"><c:choose><c:when test="${budgetCompatible}">Budget compatible</c:when><c:otherwise>Budget incompatible</c:otherwise></c:choose></div><p><c:choose><c:when test="${budgetCompatible}">Le budget unitaire respecte la fourchette du poste et le coût total respecte le budget annuel du département.</c:when><c:when test="${not budgetDansFourchette and not budgetEntrepriseCompatible}">Deux contrôles échouent : le budget unitaire saisi (${demande.budgetDemande} Ar) est hors de la fourchette autorisée (${budgetMin} à ${budgetMax} Ar) et le coût total (${budgetTotalEstime} Ar) dépasse le budget annuel du département (${budgetEntrepriseDisponible} Ar).</c:when><c:when test="${not budgetDansFourchette}">Le budget unitaire saisi (${demande.budgetDemande} Ar) est hors de la fourchette autorisée pour ce poste : ${budgetMin} à ${budgetMax} Ar.</c:when><c:otherwise>Le budget unitaire respecte la fourchette du poste, mais le coût total (${budgetTotalEstime} Ar) dépasse le budget annuel du département (${budgetEntrepriseDisponible} Ar).</c:otherwise></c:choose></p><p>Fourchette du poste : <strong>${budgetDansFourchette ? 'OK' : 'KO'}</strong> · Coût total contre budget annuel : <strong>${budgetEntrepriseCompatible ? 'OK' : 'KO'}</strong></p></div></div></div></div>
<c:if test="${demande.statutActuel.libelle == 'EN_VERIFICATION_FINANCIERE'}"><div class="bloc"><h3>Décision Finance</h3><div class="actions"><span class="note">Après validation, la demande est transmise à la Direction.</span><div class="boutons"><button type="button" class="refuser" data-open-refus="#refus-finance">Refuser la demande</button><form action="${pageContext.request.contextPath}/finance/valider/${demande.idDemande}" method="post"><button type="submit" class="valider" ${budgetCompatible ? '' : 'disabled'}>Valider le budget et transmettre →</button></form></div></div><form id="refus-finance" class="refus" data-refus-form hidden action="${pageContext.request.contextPath}/finance/refuser/${demande.idDemande}" method="post"><label for="remarque" class="refus-label">Motif du refus (obligatoire)</label><p class="refus-aide">Expliquez pourquoi le budget ne peut pas être validé.</p><textarea id="remarque" name="remarque" rows="4" class="refus-champ" required></textarea><div class="refus-boutons"><button type="button" class="annuler" data-close-refus>Annuler</button><button type="submit" class="confirmer">Confirmer le refus</button></div></form></div></c:if>
<div class="bloc"><h3>Suivi des validations</h3><ol class="suivi"><c:forEach var="h" items="${historique}"><li class="validation"><div class="validation-nom"><c:out value="${h.typeValidation}"/></div><div class="validation-corps"><p>${h.dateChangement} · <c:out value="${h.utilisateur.nom}"/> · <c:out value="${h.statut.libelleAffiche}"/></p><c:if test="${not empty h.remarque}"><p><c:out value="${h.remarque}"/></p></c:if></div></li></c:forEach></ol></div>
</section></main></div></div><script src="${pageContext.request.contextPath}/assets/js/refus-form.js"></script></body></html>
