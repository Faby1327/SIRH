<%@ page contentType="text/html;charset=UTF-8" language="java" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Budgets Finance · Besoins en personnel</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/fonts.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/base.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/besoins.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/composants.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/decision.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/finance.css"></head>
<body><div class="c-espace"><jsp:include page="/WEB-INF/views/fragments/espace-sidebar.jsp"><jsp:param name="role" value="finance"/><jsp:param name="active" value="budgets"/></jsp:include><div class="contenu"><main class="page-espace c-page-liste"><header class="entete"><div><p class="surtitre">Service Finance</p><h1>Budgets des départements</h1></div></header>
<section class="carte c-budgets" aria-labelledby="titre-budgets"><div class="entete"><h2 id="titre-budgets">Demandes et fourchettes budgétaires par département</h2><p>${demandes.size()} demandes · montants en ariary</p></div><div class="defilement"><div class="tableau" role="table" aria-labelledby="titre-budgets"><div class="ligne ligne-titres" role="row"><div class="titre">Département</div><div class="titre">Poste</div><div class="titre">Budget minimum</div><div class="titre">Budget maximum</div><div class="titre">Budget unitaire</div><div class="titre">Coût total estimé</div><div class="titre">Statut</div><div class="titre">Détail</div></div><div role="rowgroup"><c:forEach var="demande" items="${demandes}"><div class="ligne" role="row"><div class="cellule dept"><c:out value="${demande.departement.nom}"/></div><div class="cellule"><c:out value="${demande.poste.intitule}"/></div><div class="cellule montant">${budgetMinima[demande.idDemande]} Ar</div><div class="cellule montant">${budgetMaxima[demande.idDemande]} Ar</div><div class="cellule montant">${demande.budgetDemande} Ar</div><div class="cellule montant">${demande.budgetTotalEstime} Ar</div><div class="cellule"><c:out value="${demande.statutActuel.libelleAffiche}"/></div><div class="cellule"><a href="${pageContext.request.contextPath}/finance/detail/${demande.idDemande}" class="bouton">Voir</a></div></div></c:forEach><c:if test="${empty demandes}"><div class="ligne"><div class="cellule" style="grid-column:1/-1">Aucune demande enregistrée.</div></div></c:if></div></div></div><p class="legende">Le budget saisi est un montant unitaire par effectif. Le coût total estimé correspond à budget unitaire × nombre de personnes.</p></section></main></div></div></body></html>
