<%@ page contentType="text/html;charset=UTF-8" language="java" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Demandes Finance</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/fonts.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/base.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/besoins.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/composants.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/finance.css"></head>
<body><div class="c-espace"><jsp:include page="/WEB-INF/views/fragments/espace-sidebar.jsp"><jsp:param name="role" value="finance"/><jsp:param name="active" value="accueil"/></jsp:include>
<div class="contenu"><main class="page-espace c-page-liste"><header class="entete"><div><p class="surtitre">Service Finance</p><h1>Vérification budgétaire</h1></div></header><c:if test="${not empty message}"><div class="bandeau" role="status"><c:out value="${message}"/></div></c:if><c:if test="${not empty error}"><div class="bandeau bandeau-erreur" role="alert"><c:out value="${error}"/></div></c:if>
<div class="tuiles"><div class="c-tuile"><div class="tuile-label">En attente</div><div class="tuile-valeur">${aVerifier}</div></div><div class="c-tuile"><div class="tuile-label">Validé</div><div class="tuile-valeur">${validees}</div></div><div class="c-tuile"><div class="tuile-label">Refusé</div><div class="tuile-valeur">${refusees}</div></div><div class="c-tuile"><div class="tuile-label">Hors fourchette</div><div class="tuile-valeur">${incompatibles}</div></div></div>
<section class="carte c-table c-table-finance" aria-labelledby="titre-demandes"><div class="entete"><h2 id="titre-demandes">Demandes et budgets</h2><p>${demandes.size()} demandes · contrôle de la fourchette budgétaire et du budget entreprise</p></div>
<div class="filtres"><div class="recherche"><input type="search" class="champ champ-recherche" aria-label="Rechercher" placeholder="Rechercher par n°, poste, montant…" data-table-search></div><div class="filtre filtre-statut"><label for="finance-statut">Statut Finance</label><select id="finance-statut" class="champ" data-table-filter="statut"><option value="">Tous les statuts</option><option value="EN_ATTENTE">En attente</option><option value="VALIDEE">Validé</option><option value="REFUSEE">Refusé</option></select></div><div class="filtre filtre-dept"><label for="finance-dept">Département</label><select id="finance-dept" class="champ" data-table-filter="service"><option value="">Tous les départements</option><c:forEach var="d" items="${departements}"><option value="${d.nom}"><c:out value="${d.nom}"/></option></c:forEach></select></div><div class="filtre filtre-compat"><label for="finance-compat">Compatibilité</label><select id="finance-compat" class="champ" data-table-filter="compat"><option value="">Toutes</option><option value="oui">Compatible</option><option value="non">Incompatible</option></select></div></div>
<div class="defilement"><div class="tableau" role="table"><div class="ligne ligne-titres" role="row"><div class="titre">N°</div><div class="titre">Poste demandé</div><div class="titre">Département</div><div class="titre">Budget unitaire</div><div class="titre">Coût total</div><div class="titre">Compatibilité</div><div class="titre">Statut</div><div class="titre">Mise à jour</div><div class="titre">Actions</div></div><div role="rowgroup"><c:forEach var="demande" items="${demandes}"><c:set var="compatible" value="${compatibilites[demande.idDemande]}"/><c:set var="statutRole" value="${statutsRole[demande.idDemande]}"/><div class="ligne" role="row" data-table-row data-search="DP-${demande.idDemande} ${demande.poste.intitule} ${demande.departement.nom} ${demande.budgetDemande}" data-statut="${statutRole}" data-service="${demande.departement.nom}" data-compat="${compatible ? 'oui' : 'non'}"><div class="cellule numero">DP-${demande.idDemande}</div><div class="cellule poste"><c:out value="${demande.poste.intitule}"/></div><div class="cellule"><c:out value="${demande.departement.nom}"/></div><div class="cellule cout">${demande.budgetDemande} Ar</div><div class="cellule cout">${demande.budgetTotalEstime} Ar</div><div class="cellule"><span class="puce ${compatible ? 'puce-valide' : 'puce-refuse'}">${compatible ? 'Compatible' : 'Incompatible'}</span></div><div class="cellule"><span class="puce ${statutRole == 'REFUSEE' ? 'puce-refuse' : (statutRole == 'VALIDEE' ? 'puce-valide' : 'puce-attente')}"><c:choose><c:when test="${statutRole == 'REFUSEE'}">Refusé</c:when><c:when test="${statutRole == 'VALIDEE'}">Validé</c:when><c:otherwise>En attente</c:otherwise></c:choose></span></div><div class="cellule date">${demande.dateDemandeFormatee}</div><div class="cellule"><a href="${pageContext.request.contextPath}/finance/detail/${demande.idDemande}" class="bouton">Voir</a></div></div></c:forEach><c:if test="${empty demandes}"><div class="ligne"><div class="cellule" style="grid-column:1/-1">Aucune demande à afficher.</div></div></c:if></div></div></div>
<p class="legende">La compatibilité vérifie 2 conditions : budget unitaire dans la fourchette du poste et coût total estimé (budget × effectif) inférieur ou égal au budget entreprise annuel du département.</p></section></main></div></div><script src="${pageContext.request.contextPath}/assets/js/table-filtres.js"></script></body></html>
