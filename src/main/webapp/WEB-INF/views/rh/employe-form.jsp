<%@ page contentType="text/html;charset=UTF-8" language="java" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><c:out value="${formTitle}"/></title><link rel="stylesheet" href="${ctx}/assets/css/fonts.css"><link rel="stylesheet" href="${ctx}/assets/css/base.css"><link rel="stylesheet" href="${ctx}/assets/css/besoins.css"><link rel="stylesheet" href="${ctx}/assets/css/composants.css"><link rel="stylesheet" href="${ctx}/assets/css/rh.css?v=20261109-dossier"></head><body><div class="c-espace"><jsp:include page="/WEB-INF/views/fragments/espace-sidebar.jsp"><jsp:param name="role" value="rh"/><jsp:param name="active" value="employes"/></jsp:include><div class="contenu"><main class="page-espace c-page-liste c-annuaire-rh c-dossier-employe"><div class="dossier-retour"><a href="${ctx}/rh/employes">← Retour à la liste des employés</a></div><header class="entete"><div><p class="surtitre">Ressources humaines</p><h1><c:out value="${formTitle}"/></h1><p>Les champs marqués * sont obligatoires.</p></div></header><c:if test="${not empty error}"><div class="dossier-alert dossier-alert-error"><c:out value="${error}"/></div></c:if><form method="post" action="${ctx}${formAction}" class="dossier-formulaire"><section class="carte dossier-card"><div class="dossier-card-heading"><div><span class="dossier-icon dossier-icon-blue">01</span><div><h2>Identité</h2><p>Informations personnelles et coordonnées.</p></div></div></div><div class="dossier-form-grid"><label>Nom *<input class="champ" name="nom" required value="${form.nom}"></label><label>Prénom *<input class="champ" name="prenom" required value="${form.prenom}"></label><label>Sexe<select class="champ" name="sexe"><option value="">—</option><option value="M" ${form.sexe == 'M' ? 'selected' : ''}>Masculin</option><option value="F" ${form.sexe == 'F' ? 'selected' : ''}>Féminin</option></select></label><label>Date de naissance<input class="champ" type="date" name="dateNaissance" value="${form.dateNaissance}"></label><label>Lieu de naissance<input class="champ" name="lieuNaissance" value="${form.lieuNaissance}"></label><label>Nationalité<input class="champ" name="nationalite" value="${form.nationalite}"></label><label>N° CIN<input class="champ" name="cinNumero" value="${form.cinNumero}"></label><label>Date délivrance CIN<input class="champ" type="date" name="cinDateDelivrance" value="${form.cinDateDelivrance}"></label><label>Lieu délivrance CIN<input class="champ" name="cinLieuDelivrance" value="${form.cinLieuDelivrance}"></label><label>Téléphone<input class="champ" name="telephone" value="${form.telephone}"></label><label>Email personnel<input class="champ" type="email" name="emailPersonnel" value="${form.emailPersonnel}"></label><label>Adresse<input class="champ" name="adresse" value="${form.adresse}"></label><label>Commune<input class="champ" name="commune" value="${form.commune}"></label><label>Région<input class="champ" name="region" value="${form.region}"></label><label>Situation matrimoniale<select class="champ" name="situationMatrimoniale"><option value="">—</option><option value="CELIBATAIRE" ${form.situationMatrimoniale == 'CELIBATAIRE' ? 'selected' : ''}>Célibataire</option><option value="MARIE" ${form.situationMatrimoniale == 'MARIE' ? 'selected' : ''}>Marié(e)</option><option value="UNION_LIBRE" ${form.situationMatrimoniale == 'UNION_LIBRE' ? 'selected' : ''}>Union libre</option><option value="DIVORCE" ${form.situationMatrimoniale == 'DIVORCE' ? 'selected' : ''}>Divorcé(e)</option><option value="VEUF" ${form.situationMatrimoniale == 'VEUF' ? 'selected' : ''}>Veuf / veuve</option></select></label><label>Nombre d'enfants<input class="champ" type="number" min="0" name="nombreEnfants" value="${empty form.nombreEnfants ? 0 : form.nombreEnfants}"></label><label>Contact d'urgence<input class="champ" name="contactUrgenceNom" value="${form.contactUrgenceNom}"></label><label>Lien<input class="champ" name="contactUrgenceRelation" value="${form.contactUrgenceRelation}"></label><label>Téléphone urgence<input class="champ" name="contactUrgenceTelephone" value="${form.contactUrgenceTelephone}"></label></div></section><section class="carte dossier-card"><div class="dossier-card-heading"><div><span class="dossier-icon dossier-icon-green">02</span><div><h2>Situation professionnelle</h2><p>Poste, hiérarchie et statut.</p></div></div></div><div class="dossier-form-grid"><label>Département<select class="champ" name="departementId"><option value="">—</option><c:forEach var="d" items="${departements}"><option value="${d.idDepartement}" ${form.departementId == d.idDepartement ? 'selected' : ''}><c:out value="${d.nom}"/></option></c:forEach></select></label><label>Poste<select class="champ" name="posteId"><option value="">—</option><c:forEach var="p" items="${postes}"><option value="${p.idPoste}" ${form.posteId == p.idPoste ? 'selected' : ''}><c:out value="${p.intitule}"/></option></c:forEach></select></label><label>Supérieur hiérarchique<select class="champ" name="superieurId"><option value="">Aucun</option><c:forEach var="s" items="${superieurs}"><option value="${s.id}" ${form.superieurId == s.id ? 'selected' : ''}><c:out value="${s.matricule}"/> · <c:out value="${s.personne.nomComplet}"/></option></c:forEach></select></label><label>Date d'embauche *<input class="champ" type="date" name="dateEmbauche" required value="${form.dateEmbauche}"></label><label>Salaire actuel (Ar)<input class="champ" type="number" min="0" step="0.01" name="salaireActuel" value="${form.salaireActuel}"></label><label>Statut<select class="champ" name="statut"><option value="ACTIF" ${form.statut == 'ACTIF' || empty form.statut ? 'selected' : ''}>Actif</option><option value="SUSPENDU" ${form.statut == 'SUSPENDU' ? 'selected' : ''}>Suspendu</option><option value="SORTI" ${form.statut == 'SORTI' ? 'selected' : ''}>Sorti</option></select></label><label>Date de départ<input class="champ" type="date" name="dateDepart" value="${form.dateDepart}"></label></div></section><c:if test="${empty employe}"><section class="carte dossier-card"><div class="dossier-card-heading"><div><span class="dossier-icon">03</span><div><h2>Accès employé</h2><p>Facultatif : créer un compte de connexion.</p></div></div></div><div class="dossier-form-grid"><label><span><input type="checkbox" name="creerCompte" value="true" ${form.creerCompte ? 'checked' : ''}> Créer un compte employé</span></label><label>Mot de passe initial<input class="champ" type="password" name="motDePasse" minlength="8" autocomplete="new-password"></label></div></section></c:if><div class="dossier-actions"><a class="bouton" href="${ctx}/rh/employes">Annuler</a><button class="bouton bouton-principal" type="submit"><c:out value="${empty employe ? 'Créer le dossier' : 'Enregistrer les modifications'}"/></button></div></form></main></div></div></body></html>
