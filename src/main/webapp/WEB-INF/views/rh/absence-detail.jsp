<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="ctx" value="${pageContext.request.contextPath}"/><!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Demande de congé - RH</title><link rel="stylesheet" href="${ctx}/assets/css/fonts.css"><link rel="stylesheet" href="${ctx}/assets/css/base.css"><link rel="stylesheet" href="${ctx}/assets/css/besoins.css"><link rel="stylesheet" href="${ctx}/assets/css/composants.css"><link rel="stylesheet" href="${ctx}/assets/css/rh.css?v=20261112-detail-actions"></head><body><div class="c-espace"><jsp:include page="/WEB-INF/views/fragments/espace-sidebar.jsp"><jsp:param name="role" value="rh"/><jsp:param name="active" value="absences"/></jsp:include><div class="contenu"><main class="page-espace c-page-liste"><div class="dossier-retour"><a class="absence-back-btn" href="${ctx}/rh/absences">← Retour aux absences</a></div><header class="entete"><div><p class="surtitre">Demande de congé</p><h1><c:out value="${absence.employe.personne.nomComplet}"/></h1><p><c:out value="${absence.employe.matricule}"/> · envoyée le <c:out value="${absence.dateDemande}"/></p></div></header><c:if test="${not empty message}"><div class="dossier-alert dossier-alert-ok"><c:out value="${message}"/></div></c:if><c:if test="${not empty error}"><div class="dossier-alert dossier-alert-error"><c:out value="${error}"/></div></c:if><section class="carte dossier-card"><div class="dossier-card-heading"><div><span class="dossier-icon dossier-icon-blue">01</span><div><h2>Détails de la demande</h2><p>Solde disponible : <strong><c:out value="${solde}"/> jour(s)</strong></p></div></div></div><div class="detail-summary absence-detail-summary"><div><span>Début</span><strong><c:out value="${absence.dateDebut}"/></strong></div><div><span>Fin</span><strong><c:out value="${absence.dateFin}"/></strong></div><div><span>Jours demandés</span><strong><c:out value="${joursDemandes}"/> jour(s)</strong></div><div><span>Motif</span><strong><c:out value="${empty absence.motif ? 'Non renseigné' : absence.motif}"/></strong></div><div><span>Statut</span><strong><c:out value="${absence.statut}"/></strong></div></div><c:if test="${absence.statut == 'DEMANDEE'}"><form class="absence-form absence-review-form" id="absence-validation-form" action="${ctx}/rh/absences/${absence.id}/valider" method="post"><label>Remplaçant disponible<select class="champ" name="remplacantId" ${not empty remplacants ? 'required' : ''}><option value="">${empty remplacants ? 'Aucun remplaçant disponible' : 'Sélectionner un remplaçant'}</option><c:forEach var="r" items="${remplacants}"><option value="${r.id}"><c:out value="${r.personne.nomComplet}"/></option></c:forEach></select><small>Les remplaçants proposés sont actifs, du même département et disponibles sur les jours planifiés.</small></label><label class="absence-impact"><input type="checkbox" name="impactPaie" value="true"> Appliquer une retenue sur salaire</label></form><div class="absence-review-actions"><button class="bouton-principal" type="submit" form="absence-validation-form">Valider le cong&eacute;</button><form class="absence-refuse-form" action="${ctx}/rh/absences/${absence.id}/refuser" method="post"><button class="absence-refuse-btn" type="submit">Refuser la demande</button></form></div></c:if></section></main></div></div></body></html>
