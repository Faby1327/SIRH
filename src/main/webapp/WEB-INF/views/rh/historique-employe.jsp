<%@ page contentType="text/html;charset=UTF-8" language="java" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Historique employé</title><link rel="stylesheet" href="${ctx}/assets/css/fonts.css"><link rel="stylesheet" href="${ctx}/assets/css/base.css"><link rel="stylesheet" href="${ctx}/assets/css/besoins.css"><link rel="stylesheet" href="${ctx}/assets/css/composants.css"><link rel="stylesheet" href="${ctx}/assets/css/rh.css"></head><body><div class="c-espace"><jsp:include page="/WEB-INF/views/fragments/espace-sidebar.jsp"><jsp:param name="role" value="rh"/><jsp:param name="active" value="employes"/></jsp:include><div class="contenu"><main class="page-espace c-page-liste"><div class="dossier-retour"><a href="${ctx}/rh/employes/${employe.id}">← Retour au dossier</a></div><header class="entete"><div><p class="surtitre">Évolution professionnelle</p><h1>Historique de <c:out value="${employe.personne.nomComplet}"/></h1><p><c:out value="${employe.matricule}"/></p></div></header><section class="carte c-table"><table class="table-offres"><thead><tr><th>Date d'effet</th><th>Poste</th><th>Département</th><th>Supérieur</th><th>Salaire</th><th>Enregistré le</th></tr></thead><tbody><c:choose><c:when test="${empty lignes}"><tr><td colspan="6" class="dossier-empty">Aucun historique professionnel.</td></tr></c:when><c:otherwise><c:forEach var="ligne" items="${lignes}"><tr><td><c:out value="${ligne.dateEffet}"/></td><td><c:out value="${ligne.poste.intitule}"/></td><td><c:out value="${ligne.departement.nom}"/></td><td><c:out value="${empty ligne.superieur ? '-' : ligne.superieur.personne.nomComplet}"/></td><td><c:out value="${ligne.salaire}"/> Ar</td><td><c:out value="${ligne.dateEnregistrement}"/></td></tr></c:forEach></c:otherwise></c:choose></tbody></table></section></main></div></div></body></html>
