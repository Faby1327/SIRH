<%@ page contentType="text/html;charset=UTF-8" language="java" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Documents employé</title><link rel="stylesheet" href="${ctx}/assets/css/fonts.css"><link rel="stylesheet" href="${ctx}/assets/css/base.css"><link rel="stylesheet" href="${ctx}/assets/css/besoins.css"><link rel="stylesheet" href="${ctx}/assets/css/composants.css"><link rel="stylesheet" href="${ctx}/assets/css/rh.css?v=20261109-documents"></head><body><div class="c-espace"><jsp:include page="/WEB-INF/views/fragments/espace-sidebar.jsp"><jsp:param name="role" value="rh"/><jsp:param name="active" value="employes"/></jsp:include><div class="contenu"><main class="page-espace c-page-liste c-annuaire-rh c-dossier-employe"><div class="dossier-retour"><a href="${ctx}/rh/employes/${employe.id}">← Retour au dossier employé</a></div><header class="entete"><div><p class="surtitre">Dossier employé</p><h1>Documents de <c:out value="${employe.personne.nomComplet}"/></h1><p>Ajoutez et consultez les pièces du dossier.</p></div></header><c:if test="${not empty message}"><div class="dossier-alert dossier-alert-ok"><c:out value="${message}"/></div></c:if><c:if test="${not empty error}"><div class="dossier-alert dossier-alert-error"><c:out value="${error}"/></div></c:if><div class="mission-detail-grid document-grid"><section class="carte dossier-card"><div class="dossier-card-heading"><div><span class="dossier-icon dossier-icon-blue">01</span><div><h2>Ajouter un document</h2><p>PDF, image ou document bureautique.</p></div></div></div><form class="document-form" method="post" enctype="multipart/form-data" action="${ctx}/rh/employes/${employe.id}/documents"><label>Type<select class="champ" name="typeDocumentId" required><c:forEach var="type" items="${typesDocument}"><option value="${type.id}"><c:out value="${type.libelle}"/></option></c:forEach></select></label><label>Date d'expiration <small>(facultative)</small><input class="champ" type="date" name="dateExpiration"></label><label>Fichier<input class="champ" type="file" name="fichier" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" required></label><button class="bouton bouton-principal" type="submit">Ajouter le document</button></form></section><section class="carte c-table dossier-card"><div class="dossier-card-heading"><div><span class="dossier-icon dossier-icon-green">02</span><div><h2>Documents du dossier</h2><p><c:out value="${documents.size()}"/> document(s)</p></div></div></div><div class="defilement"><table class="table-offres"><thead><tr><th>Type</th><th>Fichier</th><th>Ajouté le</th><th>Expiration</th><th>Action</th></tr></thead><tbody><c:choose><c:when test="${empty documents}"><tr><td colspan="5" class="dossier-empty">Aucun document enregistré.</td></tr></c:when><c:otherwise><c:forEach var="document" items="${documents}"><tr><td><c:out value="${document.typeDocument.libelle}"/></td><td><c:out value="${document.nomFichier}"/></td><td><c:out value="${document.dateAjout}"/></td><td><c:out value="${empty document.dateExpiration ? '—' : document.dateExpiration}"/></td><td><a class="bouton" href="${ctx}/employes/${employe.id}/documents/${document.id}">Télécharger</a><form class="document-delete-form" method="post" action="${ctx}/rh/employes/${employe.id}/documents/${document.id}/supprimer"><button class="bouton bouton-danger" type="submit">Supprimer</button></form></td></tr></c:forEach></c:otherwise></c:choose></tbody></table></div></section></div></main></div></div></body></html>
