<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Détail mission - RH</title><link rel="stylesheet" href="${ctx}/assets/css/fonts.css"><link rel="stylesheet" href="${ctx}/assets/css/base.css"><link rel="stylesheet" href="${ctx}/assets/css/besoins.css"><link rel="stylesheet" href="${ctx}/assets/css/composants.css"><link rel="stylesheet" href="${ctx}/assets/css/rh.css?v=20261106-missions"></head><body><div class="c-espace"><jsp:include page="/WEB-INF/views/fragments/espace-sidebar.jsp"><jsp:param name="role" value="rh"/><jsp:param name="active" value="missions"/></jsp:include><div class="contenu"><main class="page-espace c-page-liste c-annuaire-rh c-missions-page"><div class="dossier-retour"><a href="${ctx}/rh/missions">← Retour aux missions</a></div><section class="dossier-hero mission-hero"><div><p class="surtitre">Dossier mission</p><h1><c:out value="${mission.titre}"/></h1><p class="dossier-reference"><c:out value="${mission.lieu}"/> · Responsable : <c:out value="${mission.responsable.nomComplet}"/></p></div><span class="mission-status mission-status-${mission.statut}"><c:out value="${mission.statut}"/></span></section><c:if test="${not empty message}"><div class="dossier-alert dossier-alert-ok"><c:out value="${message}"/></div></c:if><c:if test="${not empty error}"><div class="dossier-alert dossier-alert-error"><c:out value="${error}"/></div></c:if><div class="mission-detail-grid"><section class="carte dossier-card"><div class="dossier-card-heading"><div><span class="dossier-icon dossier-icon-blue">01</span><div><h2>Informations générales</h2><p>Cadre et état d'avancement de la mission.</p></div></div></div><div class="mission-info"><div><span>Description</span><strong><c:out value="${empty mission.description ? 'Aucune description' : mission.description}"/></strong></div><div><span>Période</span><strong><c:out value="${mission.dateDebut}"/> → <c:out value="${empty mission.dateFinPrevue ? 'Non définie' : mission.dateFinPrevue}"/></strong></div><div><span>Priorité</span><strong><c:out value="${mission.priorite}"/></strong></div></div><form class="mission-status-form" action="${ctx}/rh/missions/${mission.id}/statut" method="post"><label>Modifier le statut<select class="champ" name="statut"><c:forEach var="statut" items="${statuts}"><option value="${statut}" ${statut == mission.statut ? 'selected' : ''}><c:out value="${statut}"/></option></c:forEach></select></label><button class="bouton-principal" type="submit">Enregistrer</button></form></section><section class="carte dossier-card"><div class="dossier-card-heading"><div><span class="dossier-icon dossier-icon-green">02</span><div><h2>Ajouter un participant</h2><p>Affectez un employé avec son rôle.</p></div></div></div><form class="participant-form" action="${ctx}/rh/missions/${mission.id}/participants" method="post"><label>Employé<select class="champ" name="employeId" required><option value="">Sélectionner</option><c:forEach var="employe" items="${employes}"><option value="${employe.id}"><c:out value="${employe.matricule}"/> · <c:out value="${employe.personne.nomComplet}"/></option></c:forEach></select></label><label>Rôle dans la mission<input class="champ" type="text" name="roleMission" required placeholder="Ex. Développeur"></label><label>Date d'affectation<input class="champ" type="date" name="dateAffectation" required></label><button class="bouton-principal" type="submit">Affecter l'employé</button></form></section></div><section class="carte c-table dossier-card"><div class="dossier-card-heading"><div><span class="dossier-icon dossier-icon-blue">03</span><div><h2>Participants</h2><p><c:out value="${participations.size()}"/> employé(s) affecté(s)</p></div></div></div><div class="defilement"><table class="table-offres"><thead><tr><th>Employé</th><th>Rôle</th><th>Affecté le</th><th>Avancement</th><th>Statut</th></tr></thead><tbody><c:choose><c:when test="${empty participations}"><tr><td colspan="5" class="dossier-empty">Aucun employé n'est encore affecté.</td></tr></c:when><c:otherwise><c:forEach var="participation" items="${participations}"><tr><td><strong><c:out value="${participation.employe.personne.nomComplet}"/></strong><small class="planning-muted"><c:out value="${participation.employe.matricule}"/></small></td><td><c:out value="${participation.roleMission}"/></td><td><c:out value="${participation.dateAffectation}"/></td><td><div class="mission-progress"><span style="width: ${participation.avancement}%"></span></div><small><c:out value="${participation.avancement}"/> %</small></td><td><span class="puce ${participation.statut == 'TERMINEE' ? 'puce-valide' : participation.statut == 'EN_COURS' ? 'puce-info' : 'puce-brouillon'}"><c:out value="${participation.statut}"/></span></td></tr></c:forEach></c:otherwise></c:choose></tbody></table></div></section></main></div></div></body></html>
