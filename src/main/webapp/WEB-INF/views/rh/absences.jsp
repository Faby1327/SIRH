<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="ctx" value="${pageContext.request.contextPath}"/><!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Absences - RH</title><link rel="stylesheet" href="${ctx}/assets/css/fonts.css"><link rel="stylesheet" href="${ctx}/assets/css/base.css"><link rel="stylesheet" href="${ctx}/assets/css/besoins.css"><link rel="stylesheet" href="${ctx}/assets/css/composants.css"><link rel="stylesheet" href="${ctx}/assets/css/rh.css?v=20261112-absences-motif-dash"></head><body><div class="c-espace"><jsp:include page="/WEB-INF/views/fragments/espace-sidebar.jsp"><jsp:param name="role" value="rh"/><jsp:param name="active" value="absences"/></jsp:include><div class="contenu"><main class="page-espace c-page-liste c-absences-page"><header class="entete"><div><p class="surtitre">Temps de travail</p><h1>Absences et congés</h1><p>Consultez les absences et traitez les demandes de congé envoyées par les employés.</p></div></header><c:if test="${not empty message}"><div class="dossier-alert dossier-alert-ok"><c:out value="${message}"/></div></c:if><c:if test="${not empty error}"><div class="dossier-alert dossier-alert-error"><c:out value="${error}"/></div></c:if><div class="mission-detail-grid absence-grid"><section class="carte dossier-card"><div class="dossier-card-heading"><div><span class="dossier-icon dossier-icon-blue">01</span><div><h2>Enregistrer une absence</h2><p>Les congés sont saisis par les employés.</p></div></div></div><form class="absence-form" action="${ctx}/rh/absences" method="post"><label>Employé<select class="champ" id="absence-employe" name="employeId" required><option value="">Sélectionner</option><c:forEach var="e" items="${employes}"><option value="${e.id}"><c:out value="${e.matricule}"/> &middot; <c:out value="${e.personne.nomComplet}"/></option></c:forEach></select></label><label>Du<input class="champ" id="absence-debut" type="date" name="dateDebut" min="${aujourdHui}" required></label><label>Au<input class="champ" id="absence-fin" type="date" name="dateFin" min="${aujourdHui}" required></label><label>Type<select class="champ" name="typeAbsence" required><c:forEach var="type" items="${typesAbsence}"><option value="${type}"><c:out value="${type}"/></option></c:forEach></select></label><label>Remplaçant disponible<select class="champ" name="remplacantId" id="absence-remplacant"><option value="">Aucun remplaçant</option></select></label><label>Motif<textarea class="champ" name="motif" rows="3"></textarea></label><label class="absence-impact"><input type="checkbox" name="impactPaie" value="true"> Absence non payée : appliquer une retenue</label><button class="bouton-principal" type="submit">Enregistrer l'absence</button></form></section><section class="carte c-table dossier-card"><div class="dossier-card-heading"><div><span class="dossier-icon dossier-icon-green">02</span><div><h2>Liste des demandes et absences</h2><p><c:out value="${absences.size()}"/> élément(s)</p></div></div></div><div class="defilement"><table class="table-offres"><thead><tr><th>Employé</th><th>Période</th><th>Type</th><th>Remplaçant</th><th>Motif</th><th>Statut</th><th>Action</th></tr></thead><tbody><c:choose><c:when test="${empty absences}"><tr><td colspan="7" class="dossier-empty">Aucune demande ou absence enregistrée.</td></tr></c:when><c:otherwise><c:forEach var="a" items="${absences}"><tr><td><strong><c:out value="${a.employe.personne.nomComplet}"/></strong><small><c:out value="${a.employe.matricule}"/></small></td><td><c:out value="${a.dateDebut}"/> &ndash; <c:out value="${a.dateFin}"/></td><td><c:out value="${a.typeAbsence}"/></td><td><c:choose><c:when test="${empty a.remplacant}">&mdash;</c:when><c:otherwise><c:out value="${a.remplacant.personne.nomComplet}"/></c:otherwise></c:choose></td><td><c:choose><c:when test="${empty a.motif}">&mdash;</c:when><c:otherwise><c:out value="${a.motif}"/></c:otherwise></c:choose></td><td><span class="puce ${a.statut == 'VALIDEE' ? 'puce-valide' : a.statut == 'REFUSEE' ? 'puce-refuse' : a.statut == 'DEMANDEE' ? 'puce-attente' : 'puce-brouillon'}"><c:out value="${a.statut}"/></span></td><td><c:if test="${a.typeAbsence == 'CONGE'}"><a class="absence-view-btn" href="${ctx}/rh/absences/${a.id}">Voir</a></c:if></td></tr></c:forEach></c:otherwise></c:choose></tbody></table></div></section></div></main></div></div><script>(()=>{const e=document.getElementById('absence-employe'),d=document.getElementById('absence-debut'),f=document.getElementById('absence-fin'),r=document.getElementById('absence-remplacant');if(!e)return;async function load(){r.innerHTML='';const empty=document.createElement('option');empty.value='';empty.textContent='Choisir employé et période';r.appendChild(empty);r.required=false;if(!e.value||!d.value||!f.value)return;try{const q=new URLSearchParams({employeId:e.value,dateDebut:d.value,dateFin:f.value});const res=await fetch('${ctx}/rh/absences/remplacants?'+q);const rows=await res.json();r.innerHTML='';if(rows.length){r.required=true;for(const x of rows){const o=document.createElement('option');o.value=x.id;o.textContent=x.nom;r.appendChild(o)}}else{const o=document.createElement('option');o.value='';o.textContent='Aucun remplaçant disponible';r.appendChild(o)}}catch(_){r.innerHTML='';const o=document.createElement('option');o.value='';o.textContent='Disponibilités indisponibles';r.appendChild(o)}}e.addEventListener('change',load);d.addEventListener('change',()=>{f.min=d.value||'${aujourdHui}';if(f.value&&f.value<d.value)f.value=d.value;load()});f.addEventListener('change',load)})();</script></body></html>
