<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Nouvelle mission - RH</title><link rel="stylesheet" href="${ctx}/assets/css/fonts.css"><link rel="stylesheet" href="${ctx}/assets/css/base.css"><link rel="stylesheet" href="${ctx}/assets/css/besoins.css"><link rel="stylesheet" href="${ctx}/assets/css/composants.css"><link rel="stylesheet" href="${ctx}/assets/css/rh.css?v=20261106-missions"></head><body><div class="c-espace"><jsp:include page="/WEB-INF/views/fragments/espace-sidebar.jsp"><jsp:param name="role" value="rh"/><jsp:param name="active" value="missions"/></jsp:include><div class="contenu"><main class="page-espace c-page-liste c-annuaire-rh c-missions-page"><div class="dossier-retour"><a href="${ctx}/rh/missions">← Retour aux missions</a></div><header class="entete"><div><p class="surtitre">Organisation du travail</p><h1>Nouvelle mission</h1><p>Décrivez le travail à réaliser avant d'affecter les employés.</p></div></header><c:if test="${not empty error}"><div class="dossier-alert dossier-alert-error"><c:out value="${error}"/></div></c:if><section class="carte dossier-card"><form class="mission-form" action="${ctx}/rh/missions" method="post"><label><span>Titre de la mission</span><input class="champ" type="text" name="titre" required placeholder="Ex. Développer le module planning"></label><label><span>Lieu</span><input class="champ" type="text" name="lieu" placeholder="Ex. Bureau principal ou télétravail"></label><label><span>Date de début</span><input class="champ" type="date" name="dateDebut" required></label><label><span>Fin prévue <small>(facultative)</small></span><input class="champ" type="date" name="dateFinPrevue"></label><label><span>Priorité</span><select class="champ" name="priorite" required><c:forEach var="priorite" items="${priorites}"><option value="${priorite}" ${priorite == 'NORMALE' ? 'selected' : ''}><c:out value="${priorite}"/></option></c:forEach></select></label><label class="mission-description"><span>Description</span><textarea class="champ" name="description" rows="5" placeholder="Décrivez l'objectif et le résultat attendu."></textarea></label><div class="mission-submit"><a class="bouton" href="${ctx}/rh/missions">Annuler</a><button class="bouton-principal" type="submit">Créer la mission</button></div></form></section></main></div></div></body></html>
