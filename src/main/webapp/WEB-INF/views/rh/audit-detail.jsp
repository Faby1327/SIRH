<%@ page contentType="text/html;charset=UTF-8" language="java" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Détail audit</title><link rel="stylesheet" href="${ctx}/assets/css/fonts.css"><link rel="stylesheet" href="${ctx}/assets/css/base.css"><link rel="stylesheet" href="${ctx}/assets/css/besoins.css"><link rel="stylesheet" href="${ctx}/assets/css/composants.css"><link rel="stylesheet" href="${ctx}/assets/css/rh.css"></head><body><div class="c-espace"><jsp:include page="/WEB-INF/views/fragments/espace-sidebar.jsp"><jsp:param name="role" value="rh"/><jsp:param name="active" value="audit"/></jsp:include><div class="contenu"><main class="page-espace c-page-liste"><div class="dossier-retour"><a href="${ctx}/rh/audit">← Retour au journal d'audit</a></div><header class="entete"><div><p class="surtitre">Détail de l'action</p><h1><c:out value="${evenement.action.libelle}"/> · <c:out value="${evenement.typeEntite.libelle}"/></h1><p><c:out value="${evenement.dateAction}"/> · <c:out value="${evenement.utilisateur.personne.nomComplet}"/> · entité #<c:out value="${evenement.entiteId}"/></p></div></header><section class="carte c-table"><table class="table-offres"><thead><tr><th>Champ</th><th>Avant</th><th>Après</th></tr></thead><tbody><c:forEach var="entry" items="${anciennes}"><tr><td><c:out value="${entry.key}"/></td><td><c:out value="${entry.value}"/></td><td><c:out value="${nouvelles[entry.key]}"/></td></tr></c:forEach><c:forEach var="entry" items="${nouvelles}" ><c:if test="${empty anciennes[entry.key]}"><tr><td><c:out value="${entry.key}"/></td><td>—</td><td><c:out value="${entry.value}"/></td></tr></c:if></c:forEach></tbody></table></section></main></div></div></body></html>
