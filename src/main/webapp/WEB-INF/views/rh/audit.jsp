<%@ page contentType="text/html;charset=UTF-8" language="java" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Journal d'audit</title><link rel="stylesheet" href="${ctx}/assets/css/fonts.css"><link rel="stylesheet" href="${ctx}/assets/css/base.css"><link rel="stylesheet" href="${ctx}/assets/css/besoins.css"><link rel="stylesheet" href="${ctx}/assets/css/composants.css"><link rel="stylesheet" href="${ctx}/assets/css/rh.css"></head><body><div class="c-espace"><jsp:include page="/WEB-INF/views/fragments/espace-sidebar.jsp"><jsp:param name="role" value="rh"/><jsp:param name="active" value="audit"/></jsp:include><div class="contenu"><main class="page-espace c-page-liste"><header class="entete"><div><p class="surtitre">Traçabilité RH</p><h1>Journal d'audit</h1><p>Consultez les actions réalisées sur les employés, contrats et fiches de paie.</p></div></header><section class="carte"><form method="get" action="${ctx}/rh/audit" class="filtres"><select name="action"><option value="">Toutes les actions</option><c:forEach var="type" items="${typesAction}"><option value="${type.code}" ${fAction == type.code ? 'selected' : ''}><c:out value="${type.libelle}"/></option></c:forEach></select><select name="entite"><option value="">Toutes les entités</option><c:forEach var="type" items="${typesEntite}"><option value="${type.code}" ${fEntite == type.code ? 'selected' : ''}><c:out value="${type.libelle}"/></option></c:forEach></select><input name="entiteId" type="number" min="1" placeholder="ID entité" value="${fEntiteId}"><input name="utilisateur" placeholder="Utilisateur" value="${fUtilisateur}"><input name="texte" placeholder="Valeur recherchée" value="${fTexte}"><button class="bouton bouton-principal" type="submit">Rechercher</button></form></section><section class="carte c-table"><div class="dossier-card-heading"><div><h2>Événements</h2><p><c:out value="${evenements.size()}"/> résultat(s)</p></div></div><div class="defilement"><table class="table-offres"><thead><tr><th>Date</th><th>Utilisateur</th><th>Action</th><th>Entité</th><th>ID</th><th>Action</th></tr></thead><tbody><c:choose><c:when test="${empty evenements}"><tr><td colspan="6" class="dossier-empty">Aucun événement trouvé.</td></tr></c:when><c:otherwise><c:forEach var="event" items="${evenements}"><tr><td><c:out value="${event.dateAction}"/></td><td><c:out value="${event.utilisateur.personne.nomComplet}"/></td><td><c:out value="${event.action.libelle}"/></td><td><c:out value="${event.typeEntite.libelle}"/></td><td>#<c:out value="${event.entiteId}"/></td><td><a class="bouton" href="${ctx}/rh/audit/${event.id}">Consulter</a></td></tr></c:forEach></c:otherwise></c:choose></tbody></table></div></section></main></div></div></body></html>
