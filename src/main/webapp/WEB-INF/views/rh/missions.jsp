<%@ page contentType="text/html;charset=UTF-8" language="java" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Missions - RH</title><link rel="stylesheet" href="${ctx}/assets/css/fonts.css"><link rel="stylesheet" href="${ctx}/assets/css/base.css"><link rel="stylesheet" href="${ctx}/assets/css/besoins.css"><link rel="stylesheet" href="${ctx}/assets/css/composants.css"><link rel="stylesheet" href="${ctx}/assets/css/rh.css?v=20261106-missions"></head><body><div class="c-espace"><jsp:include page="/WEB-INF/views/fragments/espace-sidebar.jsp"><jsp:param name="role" value="rh"/><jsp:param name="active" value="missions"/></jsp:include><div class="contenu"><main class="page-espace c-page-liste c-annuaire-rh c-missions-page"><header class="entete"><div><p class="surtitre">Organisation du travail</p><h1>Missions</h1><p>Planifiez les travaux à réaliser et affectez les employés concernés.</p></div><a class="bouton-principal" href="${ctx}/rh/missions/nouveau">+ Nouvelle mission</a></header><c:if test="${not empty message}"><div class="dossier-alert dossier-alert-ok"><c:out value="${message}"/></div></c:if><c:if test="${not empty error}"><div class="dossier-alert dossier-alert-error"><c:out value="${error}"/></div></c:if><section class="carte c-table dossier-card"><div class="dossier-card-heading"><div><span class="dossier-icon dossier-icon-blue">01</span><div><h2>Liste des missions</h2><p><c:out value="${missions.size()}"/> mission(s) enregistrée(s)</p></div></div></div><div class="filtres"><div class="recherche"><input type="search" class="champ champ-recherche" placeholder="Rechercher par titre, lieu ou responsable…" data-table-search></div><div class="filtre"><label for="mission-statut">Statut</label><select id="mission-statut" class="champ" data-table-filter="statut"><option value="">Tous les statuts</option><option value="A_FAIRE">À faire</option><option value="EN_COURS">En cours</option><option value="TERMINEE">Terminée</option><option value="ANNULEE">Annulée</option></select></div></div><div class="defilement"><table class="table-offres"><thead><tr><th>Mission</th><th>Période</th><th>Priorité</th><th>Responsable</th><th>Statut</th><th>Action</th></tr></thead><tbody><c:choose><c:when test="${empty missions}"><tr><td colspan="6" class="dossier-empty">Aucune mission n'est encore enregistrée.</td></tr></c:when><c:otherwise><c:forEach var="mission" items="${missions}"><tr data-table-row data-search="${mission.titre} ${mission.lieu} ${mission.responsable.nomComplet}" data-statut="${mission.statut}"><td><strong><c:out value="${mission.titre}"/></strong><small class="planning-muted"><c:out value="${mission.lieu}"/></small></td><td><c:out value="${mission.dateDebut}"/> <c:if test="${not empty mission.dateFinPrevue}">→ <c:out value="${mission.dateFinPrevue}"/></c:if></td><td><span class="mission-priority priority-${mission.priorite}"><c:out value="${mission.priorite}"/></span></td><td><c:out value="${mission.responsable.nomComplet}"/></td><td><span class="puce ${mission.statut == 'TERMINEE' ? 'puce-valide' : mission.statut == 'EN_COURS' ? 'puce-info' : mission.statut == 'ANNULEE' ? 'puce-refuse' : 'puce-brouillon'}"><c:out value="${mission.statut}"/></span></td><td><a class="bouton" href="${ctx}/rh/missions/${mission.id}">Voir le détail</a></td></tr></c:forEach></c:otherwise></c:choose></tbody></table></div></section></main></div></div><script src="${ctx}/assets/js/table-filtres.js"></script></body></html>
